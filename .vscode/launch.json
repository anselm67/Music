            ]
        },
        {
            "name": "pdmx stats",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.pdmx",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--csv",
                "Staff16.csv",
                "-o",
                "25000",
                "-n",
                "50000",
                "stats",
