    "version": "0.2.0",
    "configurations": [
        // kern cli
        {
            "name": "kern midi",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.kern",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "midi",
                "/home/anselm/datasets/kern-sheet/haydn/keyboard/uesonatas/sonata45-3a.krn"
            ]
        },
        {
            "name": "kern tokenize",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.kern",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "tokenize",
                "-o",
                "foo.tok",
                "/home/anselm/datasets/PDMX/krn/14/34/QmWNCrJLSs8HaHpCUKtvZUCb8nZLWL3R4cFV7ouf9Mei9r.krn"
            ]
